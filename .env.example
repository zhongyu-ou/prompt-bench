# Copy to your own private env file, chmod 600, then fill real keys locally.
# These are environment variable references used by the seeded providers.
# Existing server environment values override --env-file entries.
# Provider manual overrides (entered in the UI) take priority over these env values.
# Blank UI password means unchanged; explicit Clear removes override and uses env.
# Back up data-dir credentials.key with the SQLite file for saved manual overrides.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_4O_KEY=
TYPESAFE_API_KEY=
